# Environment Configuration
LOG_LEVEL=info

# ICAI Credentials (Required for login & search)
ICAI_USER_ID=your_icai_email@icai.org
ICAI_PASSWORD=your_icai_password

# Scraper Settings (Optional - can customize)
STUDENT_PREFIX=WRO
START_NUMBER=873000
RECORD_COUNT=100000

# Performance
CONCURRENCY=5
BATCH_SIZE=10000
SESSION_TIMEOUT=300000
MAX_EXPORT_COUNT=10000
EXPORT_CONCURRENCY=20
MAX_EXPORT_CONCURRENCY=40

# Proxy Rotation (for high-speed bulk without IP block)
# Comma-separated list of proxy URLs: http://user:pass@host:port
# Or path to a file with one proxy per line
# PROXY_LIST=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
# PROXY_FILE=./proxies.txt

# Paths (Optional - for local development only)
OUTPUT_DIR=./output
LOG_DIR=./logs
